# Together V1 — Amaya Bay
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173
LOG_LEVEL=info
API_RATE_LIMIT_PER_MINUTE=240
SHUTDOWN_TIMEOUT_MS=10000

# Local header authentication is disabled unless explicitly enabled.
# Only set true in a local development environment with no Supabase auth session.
ALLOW_DEV_AUTH=false

# Supabase server (leave blank for documented local-development fallback)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
SUPABASE_MEMORY_BUCKET=together-memories

# Client-safe Supabase settings
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SERVER_URL=http://localhost:3001

# Voice infrastructure. TURN_SHARED_SECRET stays server-only. The server mints
# short-lived credentials from it for authenticated clients.
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_SHARED_SECRET=
TURN_TTL_SECONDS=3600

# Redis is intentionally optional for a single V1 game-server instance.
REDIS_URL=
