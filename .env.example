# Together V1 — Amaya Bay
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173
LOG_LEVEL=info

# Supabase server (leave blank for documented local-development fallback)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
SUPABASE_MEMORY_BUCKET=together-memories

# Client-safe Supabase settings
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SERVER_URL=http://localhost:3001

# Optional voice infrastructure. Never place production secrets in this file.
VITE_STUN_URL=stun:stun.l.google.com:19302
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Redis is intentionally optional for a single V1 game-server instance.
REDIS_URL=
